* text=auto
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.meta text eol=lf
*.cs text eol=lf
*.ps1 text eol=crlf
*.fbx filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.psd filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.exr filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp4 filter=lfs diff=lfs merge=lfs -text
Assets/SORA/Characters/**/*.png filter=lfs diff=lfs merge=lfs -text

# Git LFS for reusable CC0 third-party art sources (not inside Unity Assets yet)
ArtSource/ThirdParty/CC0/**/*.glb filter=lfs diff=lfs merge=lfs -text
ArtSource/ThirdParty/CC0/**/*.jpg filter=lfs diff=lfs merge=lfs -text
ArtSource/ThirdParty/CC0/**/*.png filter=lfs diff=lfs merge=lfs -text
